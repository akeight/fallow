// AI interpretation setup
//
// 1. Copy this file to Fallow/Secrets.xcconfig (same folder). That file is gitignored.
// 2. Paste your OpenAI API key below. No quotes. Do not commit it.
// 3. Optionally change the model. It must support Structured Outputs (json_schema).
// 4. Clean build (Shift-Cmd-K) and run. Both the iPhone and Mac apps read it.
//
// Without a key, FALLOW uses its on-device heuristic interpreter instead.
// The key is embedded in the built app's Info.plist: fine for a personal prototype,
// not for distribution (that needs a server-side proxy).

FALLOW_OPENAI_API_KEY = sk-your-key-here
FALLOW_OPENAI_MODEL = gpt-4.1-mini
